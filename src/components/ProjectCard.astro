---
import type { Project } from '../data/projects';
import { imgAttrs } from '../lib/transform';
interface Props { project: Project; eager?: boolean; headingLevel?: 'h2' | 'h3' }
const { project: p, eager = false, headingLevel = 'h2' } = Astro.props;
const img = imgAttrs(p.cover);
const H = headingLevel;
---
<a class="card reveal" href={`/${p.slug}`}>
  <figure class="card-media">
    <img src={img.src} width={img.width} height={img.height} alt={p.coverAlt}
      loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} decoding="async"
      sizes="(max-width: 809px) 100vw, 50vw" />
  </figure>
  <div class="card-text">
    <H class="card-title">{p.title}</H>
    <p class="card-sub">{p.summary}</p>
  </div>
</a>

<style>
  .card { display: flex; flex-direction: column; gap: 24px; padding: 16px 16px 24px; border-radius: 26px; background: #fff; border: 1px solid rgba(0, 0, 0, .05); text-decoration: none; color: inherit; transition: box-shadow .4s, translate .4s; }
  .card:hover { box-shadow: 0 1px 2px rgba(0,0,0,.04), 0 8px 24px rgba(0,0,0,.06); translate: 0 -2px; }
  .card-media { margin: 0; border-radius: 24px; overflow: hidden; aspect-ratio: 528 / 391; background: #eee; }
  .card-media img { width: 100%; height: 100%; object-fit: cover; display: block; transition: scale .8s cubic-bezier(.19, 0, .5, 1); }
  .card:hover .card-media img { scale: 1.03; }
  .card-text { padding-left: 4px; line-height: 1.5; }
  .card-title { margin: 0; font-size: 16px; font-weight: 400; color: rgb(23, 23, 23); }
  .card-sub { margin: 0; color: rgb(128, 128, 128); }
</style>
