---
import { pageBg } from '../data/projects';
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="The page you’re looking for doesn’t exist or has been moved." bg={pageBg.black} theme="dark" noindex>
  <main id="content" class="nf">
    <h1>Oops. It looks like the page you're trying to reach <span>doesn't exist</span> or has been moved.</h1>
    <a class="btn" href="/">Go to Home</a>
  </main>
</Base>

<style>
  .nf { min-height: 60vh; max-width: 900px; margin: 0 auto; padding: 80px var(--page-pad); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 40px; text-align: center; }
  h1 { margin: 0; font-size: clamp(28px, 4vw, 40px); line-height: 1.3; letter-spacing: -1px; font-weight: 500; text-wrap: balance; }
  h1 span { color: var(--c-gray); }
</style>
