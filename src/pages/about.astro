---
import Base from '../layouts/Base.astro';
import { site } from '../data/projects';

const schema = [{
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  url: `${site.url}/about`,
  name: 'About • Nathalia Garcia',
  mainEntity: { '@id': `${site.url}/#person` },
}];

const facts = [
  { k: 'Experience', v: '10+ years in B2B & B2B2C' },
  { k: 'Currently', v: 'Product Designer at doola (YC S20)', href: 'https://www.doola.com/' },
  { k: 'Building', v: 'ocalendar, event discovery 🇧🇷', href: 'https://ocalendar.io/' },
  { k: 'Based in', v: 'São Paulo, Brazil' },
];
---
<Base title="About" description="Nathalia Garcia is a Brazilian Product Designer with 10+ years of experience in B2B and B2B2C, from SaaS and BI tools to AI-powered features. Based in São Paulo."
  image="VADMgL6TToEMrbOoqLbcalVBQ.png" schema={schema}>
  <main id="content" class="about">

    <section class="ab-hero" aria-labelledby="ab-title">
      <figure class="ab-photo" data-a="fade">
        <img src="/images/MuDd075zDwLUPaO38aI0fSKw6g.webp" width="1079" height="1260" alt="Portrait of Nathalia Garcia" fetchpriority="high" decoding="async" />
      </figure>
      <div class="ab-intro">
        <h1 id="ab-title" data-a="mount">
          I'm a Product Designer with 10+ years of experience in B2B and B2B2C.
          <span>Over the years, I've had the privilege of designing products across various industries, including Healthcare, Real estate, Business intelligence, and Entertainment, crafting solutions like SaaS platforms, BI tools, Productivity apps and AI-powered features.</span>
        </h1>
        <dl class="ab-facts" data-a="mount">
          {facts.map((f) => (
            <div>
              <dt>{f.k}</dt>
              <dd>{f.href ? <a href={f.href} target="_blank" rel="noopener">{f.v}</a> : f.v}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <section class="ab-row" aria-labelledby="ab-story">
      <h2 id="ab-story" class="ab-label" data-a="up">How it started</h2>
      <div class="ab-body">
        <p class="ab-big" data-a="up">I started designing when I was 12, and it was because of Counter-Strike.</p>
        <p data-a="up">I had a team there and we used to play in tournaments. Over time, we started winning a few of them, and that's when I realized we needed a website since every other team had one. That's when, between matches and school, I decided to learn HTML, CSS, Photoshop, and CorelDRAW. This decision completely changed my life as it immersed me in a new world: design.</p>
        <p data-a="up">At some point, I realized I was spending more time designing than actually playing CS. The idea of creating something people could interact with totally hooked me. What started as a hobby became my job, and I still feel very lucky for that.</p>
      </div>
    </section>

    <section class="ab-row" aria-labelledby="ab-approach">
      <h2 id="ab-approach" class="ab-label" data-a="up">How I think about design</h2>
      <div class="ab-body">
        <p class="ab-big" data-a="up">Design has taught me that it's not just about making things look nice, it's about making them actually work.</p>
        <p data-a="up">It's about understanding people, their habits, behaviors, and feelings. Realizing this shifted my focus from technology to the people.</p>
        <p data-a="up">I love figuring out how things work and finding ways to make them better, whether by creating something new or improving what's already there.</p>
        <blockquote data-a="up">For me, good design doesn't always need to reinvent the wheel. Small, thoughtful changes can also solve problems and make people's life easier and that's where my passion lies: designing systems that empower people and help improve their productivity.</blockquote>
        <p data-a="up">Every project has been a chance to learn, evolve, and create something meaningful.</p>
      </div>
    </section>

    <section class="ab-row" aria-labelledby="ab-outside">
      <h2 id="ab-outside" class="ab-label" data-a="up">Outside of work</h2>
      <div class="ab-body">
        <ul class="ab-list">
          <li data-a="up">
            <a href="https://ocalendar.io/events" target="_blank" rel="noopener">
              <span class="ab-list-head"><span class="ab-list-kicker">Side project</span><strong>ocalendar <span class="ab-arrow" aria-hidden="true">↗</span></strong></span>
              <span class="ab-list-text">Outside of my work, I'm building my first independent project with a partner. Our product, ocalendar, is a web app that gathers all city events in São Paulo into a user-friendly platform. Starting from scratch, we reached 10,000 organic visitors in the first 30 days after our launch, and we've been experiencing a steady monthly increase in traffic ever since.</span>
              <span class="ab-list-stat" aria-hidden="true"><b>10k</b>organic visitors<br />in the first 30 days</span>
            </a>
          </li>
          <li data-a="up">
            <a href="https://www.instagram.com/remont.ux" target="_blank" rel="noopener">
              <span class="ab-list-head"><span class="ab-list-kicker">Content</span><strong>Remont <span class="ab-arrow" aria-hidden="true">↗</span></strong></span>
              <span class="ab-list-text">I also talk about how old products influence our lives at Remont.</span>
              <span class="ab-list-stat" aria-hidden="true"></span>
            </a>
          </li>
        </ul>
        <p data-a="up">I'm currently based in São Paulo, Brazil and when I'm not designing, you'll probably find me playing instruments, exploring new spots in the city, planning my next adventure, or writing ideas I hope to bring to life someday.</p>
      </div>
    </section>

    <section class="ab-end" aria-labelledby="ab-chat">
      <h2 id="ab-chat" data-a="up">If you've made it this far and want to know more, feel free to reach out, I'd love to chat!</h2>
      <div class="ab-cta" data-a="up">
        <a class="btn btn-primary" href="/#contact">Book a call</a>
        <a class="btn" href={site.linkedin} target="_blank" rel="noopener">LinkedIn <span aria-hidden="true">↗</span></a>
      </div>
    </section>
  </main>
</Base>

<style>
  .about { 
    max-width: 1400px; margin: 0 auto; padding: calc(80px * var(--s)) var(--page-pad) calc(40px * var(--s)); color: var(--c-ink); }

  /* hero: photo + intro statement + role summary */
  .ab-hero { display: grid; grid-template-columns: minmax(0, 340px) minmax(0, 1fr); gap: 80px; align-items: end; padding-bottom: 96px; border-bottom: 1px solid var(--c-line); }
  .ab-photo { margin: 0; border-radius: var(--r-lg); overflow: hidden; aspect-ratio: 4 / 5; background: var(--c-placeholder); }
  .ab-photo img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: 50% 30%; }
  .ab-hero h1 { margin: 0; font-size: 36px; line-height: 1.3; letter-spacing: -.8px; font-weight: 500; text-wrap: pretty; }
  .ab-hero h1 span { color: var(--c-gray); }
  .ab-facts { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 24px; margin: 48px 0 0; padding-top: 24px; border-top: 1px solid var(--c-line); }
  .ab-facts dt { font-size: 14px; color: var(--c-gray); }
  .ab-facts dd { margin: 6px 0 0; font-size: 16px; line-height: 1.4; font-weight: 500; }
  .ab-facts a { color: inherit; text-decoration: underline; text-decoration-color: var(--c-underline); text-underline-offset: 3px; }
  .ab-facts a:hover { text-decoration-color: currentColor; }
  .btn { display: inline-flex; align-items: center; gap: 6px; height: 44px; padding: 0 20px; border-radius: var(--r-pill); border: 1px solid var(--c-line);
    font-size: 16px; font-weight: 500; color: var(--c-ink); text-decoration: none; background: var(--c-glass); transition: background-color .25s, border-color .25s; }
  .btn:hover { border-color: var(--c-line-strong); background: var(--c-white); }
  .btn-primary { background: var(--c-ink); border-color: var(--c-ink); color: var(--c-white); }
  .btn-primary:hover { background: var(--c-ink-soft); border-color: var(--c-ink-soft); }
  .btn:focus-visible { outline: 2px solid var(--c-ink); outline-offset: 3px; }
  .ab-cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }

  /* two-column rows */
  .ab-row { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); gap: 80px; padding: 96px 0; border-bottom: 1px solid var(--c-line); }
  .ab-label { margin: 0; font-size: 18px; line-height: 1.4; font-weight: 500; color: var(--c-text-muted); align-self: start; position: sticky; top: 104px; }
  .ab-body { display: flex; flex-direction: column; gap: 20px; max-width: 760px; }
  .ab-body p { margin: 0; font-size: 18px; line-height: 1.7; color: var(--c-text-muted); text-wrap: pretty; }
  .ab-body .ab-big { font-size: 32px; line-height: 1.3; letter-spacing: -.6px; font-weight: 500; color: var(--c-ink); text-wrap: balance; }
  .ab-body blockquote { margin: 12px 0; padding: 4px 0 4px 24px; border-left: 2px solid var(--c-ink); font-size: 22px; line-height: 1.5; color: var(--c-ink); text-wrap: pretty; }

  /* outside of work: editorial list */
  .ab-list { list-style: none; margin: 0 0 16px; padding: 0; border-top: 1px solid var(--c-line); }
  .ab-list li { border-bottom: 1px solid var(--c-line); }
  .ab-list a { display: grid; grid-template-columns: 160px minmax(0, 1fr) 150px; gap: 32px; align-items: start; padding: 28px 0; text-decoration: none; color: var(--c-text-muted); transition: padding .4s cubic-bezier(.19, 0, .5, 1); }
  .ab-list a:hover { padding-left: 8px; }
  .ab-list a:focus-visible { outline: 2px solid var(--c-ink); outline-offset: 2px; border-radius: 8px; }
  .ab-list-head { display: flex; flex-direction: column; gap: 6px; }
  .ab-list-kicker { font-size: 13px; text-transform: uppercase; letter-spacing: .06em; }
  .ab-list-head strong { font-size: 22px; line-height: 1.2; font-weight: 500; letter-spacing: -.3px; color: var(--c-ink); white-space: nowrap; }
  .ab-arrow { display: inline-block; font-size: .8em; transition: transform .35s cubic-bezier(.19, 0, .5, 1); }
  .ab-list a:hover .ab-arrow { transform: translate(3px, -3px); }
  .ab-list-text { font-size: 17px; line-height: 1.65; text-wrap: pretty; }
  .ab-list-stat { font-size: 13px; line-height: 1.4; text-align: right; }
  .ab-list-stat b { display: block; font-size: 40px; line-height: 1; letter-spacing: -1.5px; font-weight: 500; color: var(--c-ink); margin-bottom: 6px; }

  /* closing */
  .ab-end { padding: 120px 0 64px; text-align: center; }
  .ab-end h2 { margin: 0 auto; max-width: 820px; font-size: 40px; line-height: 1.2; letter-spacing: -1px; font-weight: 500; text-wrap: balance; }
  .ab-end p { margin: 12px 0 0; font-size: 18px; color: var(--c-text-muted); }
  .ab-end .ab-cta { justify-content: center; }

  @media (max-width: 1099.98px) {
    .ab-hero { gap: 48px; grid-template-columns: minmax(0, 260px) minmax(0, 1fr); padding-bottom: 72px; }
    .ab-hero h1 { font-size: 28px; }
    .ab-facts { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .ab-row { grid-template-columns: minmax(0, 1fr); gap: 24px; padding: 72px 0; }
    .ab-label { position: static; }
    .ab-list a { grid-template-columns: 140px minmax(0, 1fr) 120px; gap: 24px; }
    .ab-body .ab-big { font-size: 28px; }
  }
  @media (max-width: 809.98px) {
    .ab-hero { grid-template-columns: minmax(0, 1fr); gap: 28px; padding-bottom: 56px; align-items: start; }
    .ab-photo { width: 140px; aspect-ratio: 1; border-radius: var(--r-md); }
    .ab-hero h1 { font-size: 22px; letter-spacing: -.3px; }
    .ab-facts { margin-top: 28px; gap: 16px; }
    .ab-row { padding: 56px 0; }
    .ab-body .ab-big { font-size: 24px; }
    .ab-body p { font-size: 16px; }
    .ab-body blockquote { font-size: 18px; padding-left: 16px; }
    .ab-list a { grid-template-columns: minmax(0, 1fr); gap: 12px; padding: 24px 0; }
    .ab-list a:hover { padding-left: 0; }
    .ab-list-stat { text-align: left; } .ab-list-stat:empty { display: none; }
    .ab-end { padding: 80px 0 40px; }
    .ab-end h2 { font-size: 30px; }
  }
</style>
