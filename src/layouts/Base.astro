---
import '@fontsource-variable/inter/opsz.css';
import '../styles/global.css';
import { site } from '../data/projects';
import { imgAttrs } from '../lib/transform';
import Header from '../components/Header.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string; // file name in public/images (original format)
  imageAlt?: string;
  bg?: string;
  theme?: 'light' | 'dark';
  schema?: Record<string, unknown>[];
  noindex?: boolean;
  type?: 'website' | 'article';
  bodyClass?: string;
  nav?: 'home' | 'case';
}

const {
  title,
  description = site.description,
  image = site.socialImage,
  imageAlt = 'Nathalia Garcia – Product Designer',
  bg = '#fff',
  theme = 'light',
  schema = [],
  noindex = false,
  type = 'website',
  bodyClass = '',
  nav = 'case',
} = Astro.props;

const fullTitle = title ? `${title} • ${site.name}` : site.title;
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '');
const canonical = `${site.url}${path === '/index' ? '' : path}`;
const ogImage = `${site.url}/images/${image}`;
const ogMeta = imgAttrs(image);
const current = (href: string) => (path === href ? 'page' : undefined);

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${site.url}/#person`,
  name: 'Nathalia Garcia',
  alternateName: 'naatz',
  jobTitle: 'Product Designer',
  url: site.url,
  image: `${site.url}/images/MuDd075zDwLUPaO38aI0fSKw6g.webp`,
  sameAs: [site.linkedin, 'https://www.instagram.com/remont.ux'],
  address: { '@type': 'PostalAddress', addressLocality: 'São Paulo', addressCountry: 'BR' },
  knowsAbout: ['Product Design', 'UX Design', 'UI Design', 'Motion Design', 'Growth', 'SEO', 'Branding'],
};
const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${site.url}/#website`,
  url: site.url,
  name: 'naatz – Nathalia Garcia',
  inLanguage: 'en',
  publisher: { '@id': `${site.url}/#person` },
};
const graph = [person, website, ...schema];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="author" content="Nathalia Garcia" />
    <meta name="theme-color" content={bg} />

    <link rel="icon" type="image/png" href="/images/8KNtFvAE2KUSBYdS1cNZMu1xDI.png" />
    <link rel="apple-touch-icon" href="/images/8KNtFvAE2KUSBYdS1cNZMu1xDI.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="naatz – Nathalia Garcia" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={imageAlt} />
    {ogMeta.width && <meta property="og:image:width" content={String(Math.min(ogMeta.width, 1200))} />}
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://player.vimeo.com" crossorigin />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(graph)} />
    <script is:inline>document.documentElement.classList.add('js')</script>

    <!-- Google Analytics (same property used on Framer) -->
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${site.ga}`}></script>
    <script is:inline define:vars={{ ga: site.ga }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', ga);
    </script>
  </head>
  <body class={`${theme} ${bodyClass}`.trim()} style={`--bg:${bg}`}>
    <a class="skip" href="#content">Skip to content</a>
    <Header variant={nav} current={path} />

    <slot />

    <footer class="site-footer">
      <p>© {new Date().getFullYear()} – Nathalia Garcia</p>
    </footer>

    <script>
      // Framer-style appear effects: [data-a] elements animate once when they enter the viewport.
      // Content is fully visible without JS (the hidden state only applies under html.js), so SEO is unaffected.
      const io = new IntersectionObserver((entries) => {
        for (const e of entries) if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
      }, { threshold: 0 });
      document.querySelectorAll('[data-a]').forEach((el) => {
        if (el.closest('.slides, .tabs')) return el.classList.add('in');
        if ((el as HTMLElement).dataset.a === 'mount') return requestAnimationFrame(() => requestAnimationFrame(() => el.classList.add('in')));
        io.observe(el);
      });

      // Slides (prev/next, pagination dots, optional autoplay loop)
      document.querySelectorAll<HTMLElement>('.slides').forEach((root) => {
        const track = root.querySelector<HTMLElement>('.slides-track')!;
        const n = track.children.length;
        const loop = !!root.dataset.autoplay;
        const prev = root.querySelector<HTMLButtonElement>('.slides-prev');
        const next = root.querySelector<HTMLButtonElement>('.slides-next');
        const dotsEl = root.querySelector<HTMLElement>('.slides-dots');
        const idx = () => Math.round(track.scrollLeft / Math.max(1, track.clientWidth));
        const to = (i: number) => track.scrollTo({ left: ((i + n) % n) * (track.scrollWidth / n), behavior: 'smooth' });
        const dots = Array.from({ length: n }, (_, i) => {
          const d = document.createElement('button');
          d.type = 'button';
          d.setAttribute('aria-label', `Go to slide ${i + 1}`);
          d.addEventListener('click', () => to(i));
          dotsEl?.append(d);
          return d;
        });
        const sync = () => {
          const i = idx();
          dots.forEach((d, k) => d.setAttribute('aria-current', String(k === i)));
          if (!loop) { if (prev) prev.hidden = i === 0; if (next) next.hidden = i === n - 1; }
        };
        let raf = 0;
        track.addEventListener('scroll', () => { cancelAnimationFrame(raf); raf = requestAnimationFrame(sync); }, { passive: true });
        sync();
        prev?.addEventListener('click', () => to(idx() - 1));
        next?.addEventListener('click', () => to(idx() + 1));
        const ms = Number(root.dataset.autoplay);
        if (ms && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
          let t = 0;
          const start = () => { clearInterval(t); t = window.setInterval(() => to(idx() + 1), ms); };
          const vis = new IntersectionObserver(([e]) => (e.isIntersecting ? start() : clearInterval(t)));
          vis.observe(root);
          root.addEventListener('pointerenter', () => clearInterval(t));
          root.addEventListener('pointerleave', start);
        }
      });

      // Tabs
      document.querySelectorAll<HTMLElement>('.tabs').forEach((root) => {
        const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
        const select = (tab: HTMLButtonElement) => {
          for (const t of tabs) {
            const on = t === tab;
            t.setAttribute('aria-selected', String(on));
            t.tabIndex = on ? 0 : -1;
            root.querySelector<HTMLElement>('#' + t.getAttribute('aria-controls'))!.hidden = !on;
          }
        };
        tabs.forEach((t, i) => {
          t.addEventListener('click', () => select(t));
          t.addEventListener('keydown', (e) => {
            const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
            if (d) { const n = tabs[(i + d + tabs.length) % tabs.length]; select(n); n.focus(); }
          });
        });
      });

      // Play muted loop videos only while visible
      const vio = new IntersectionObserver((entries) => {
        for (const e of entries) {
          const v = e.target as HTMLVideoElement;
          if (e.isIntersecting) { v.preload = 'auto'; v.play().catch(() => {}); } else v.pause();
        }
      }, { rootMargin: '200px' });
      document.querySelectorAll('video.vid').forEach((v) => vio.observe(v));
    </script>
  </body>
</html>
