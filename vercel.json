{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/sitemap-index.xml",
      "destination": "/sitemap.xml",
      "permanent": true
    },
    {
      "source": "/sitemap-0.xml",
      "destination": "/sitemap.xml",
      "permanent": true
    },
    {
      "source": "/projects/:slug",
      "destination": "/:slug",
      "statusCode": 301
    },
    {
      "source": "/projects",
      "destination": "/#work",
      "statusCode": 301
    },
    {
      "source": "/archive",
      "destination": "/about",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/(images|videos|_astro)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
